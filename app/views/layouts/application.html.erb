<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Notava" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <script>
      // Handle user interaction for autoplay
      document.addEventListener('DOMContentLoaded', function() {
        const interactionEvents = ['mousedown', 'keydown', 'touchstart', 'click'];
        
        function handleUserInteraction() {
          document.documentElement.setAttribute('data-user-interacted', 'true');
          console.log("User interaction detected, autoplay should work now");
          
          // Try to resume any pending audio playback
          if (window.playerController && window.playerController.resumePendingPlayback) {
            window.playerController.resumePendingPlayback();
          }
          
          // Remove event listeners once interaction is detected
          interactionEvents.forEach(event => {
            document.removeEventListener(event, handleUserInteraction);
          });
        }
        
        // Add event listeners for user interaction
        interactionEvents.forEach(event => {
          document.addEventListener(event, handleUserInteraction);
        });
        
        // Add keyboard navigation support for search
        document.addEventListener('keydown', function(event) {
          // If Escape is pressed, close any open dropdowns
          if (event.key === 'Escape') {
            const dropdowns = document.querySelectorAll('[data-search-target="dropdown"]');
            dropdowns.forEach(dropdown => {
              if (!dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
              }
            });
            
            // Also close any open modals
            const modals = document.querySelectorAll('[data-playlist-target="addToPlaylistModal"]');
            modals.forEach(modal => {
              if (!modal.classList.contains('hidden')) {
                modal.classList.add('hidden');
                document.body.classList.remove('modal-open');
              }
            });
          }
        });
      });
    </script>
    
    <style>
      /* Modal styles */
      body.modal-open::after {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 998;
      }
      
      /* Make sure buttons have pointer cursor */
      button {
        cursor: pointer;
      }
      
      /* Notification animation */
      #playlist-notification {
        transition: transform 0.3s ease, opacity 0.3s ease;
      }
      
      /* Search dropdown styles */
      #search_dropdown {
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 9999 !important; /* Highest z-index to appear above all elements */
        position: fixed; /* Fixed position to ensure it's not affected by other elements */
        background-color: rgba(30, 41, 59, 0.98) !important; /* Darker and more opaque background */
        backdrop-filter: blur(12px); /* Enhanced blur effect */
        border: 1px solid rgba(8, 145, 178, 0.2); /* Subtle border */
      }
      
      #search_dropdown:not(.hidden) {
        animation: dropdownFadeIn 0.2s ease-out;
        opacity: 1 !important; /* Force full opacity */
      }
      
      @keyframes dropdownFadeIn {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      /* Search input focus state */
      [data-search-target="input"].dropdown-active {
        border-color: rgba(8, 145, 178, 0.6); /* cyan-600 with opacity */
      }
      
      /* Search result item styles */
      #search_results .search-result-item,
      #search_results [data-action="click->search#selectSuggestion"] {
        transition: background-color 0.15s ease;
        position: relative;
      }
      
      #search_results .search-result-item:hover,
      #search_results [data-action="click->search#selectSuggestion"]:hover {
        background-color: rgba(30, 58, 138, 0.4); /* indigo-900 with opacity */
      }
      
      #search_results .search-result-item.selected,
      #search_results [data-action="click->search#selectSuggestion"].selected {
        background-color: rgba(8, 145, 178, 0.2); /* cyan-600 with opacity */
      }
      
      /* Add left border indicator for selected item */
      #search_results .search-result-item.selected::before,
      #search_results [data-action="click->search#selectSuggestion"].selected::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background-color: rgba(8, 145, 178, 0.8); /* cyan-600 with opacity */
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
      }
      
      /* Keyboard navigation hint */
      #search_dropdown:not(.hidden)::after {
        content: 'Use ↑↓ to navigate, Enter to select';
        display: block;
        text-align: center;
        padding: 8px;
        font-size: 11px;
        color: rgba(165, 180, 252, 0.6); /* indigo-300 with opacity */
        border-top: 1px solid rgba(79, 70, 229, 0.2); /* indigo-600 with opacity */
      }
    </style>
  </head>

  <body class="min-h-full bg-gradient-to-br from-[#0d1b2a] to-[#415a77] text-[#e0e1dd]">
    <main class="min-h-screen">
      <%= yield %>
    </main>
    
    <!-- Global Player Bar -->
    <%= render 'shared/player' unless @hide_player %>
    
    <!-- Add to Playlist Modal -->
    <div data-controller="playlist">
      <div class="hidden fixed inset-0 z-[999] flex items-center justify-center p-4" data-playlist-target="addToPlaylistModal">
        <div class="bg-indigo-950/95 backdrop-blur-md rounded-lg shadow-xl w-full max-w-md overflow-hidden">
          <div class="px-6 py-4 border-b border-cyan-900/30 flex justify-between items-center">
            <h3 class="text-lg font-medium text-white">Add to Playlist</h3>
            <button class="text-gray-400 hover:text-white" data-action="click->playlist#hideModal">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
              </svg>
            </button>
          </div>
          <div class="max-h-96 overflow-y-auto" data-playlist-target="playlistList">
            <!-- Playlist options will be rendered here -->
            <div class="p-4 text-center text-gray-400">
              <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-cyan-500 mx-auto"></div>
              <p class="mt-2">Loading playlists...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
