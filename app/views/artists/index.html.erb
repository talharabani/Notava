<div class="p-6">
  <!-- Search Form -->
  <div class="mb-8">
    <%= form_with url: artists_path, method: :get, class: "flex gap-4" do |f| %>
      <div class="flex-1">
        <%= f.text_field :query, 
            value: params[:query],
            class: "w-full px-4 py-2 rounded-lg bg-gray-800 text-white border border-gray-700 focus:border-pink-500 focus:ring-1 focus:ring-pink-500",
            placeholder: "Search for artists...",
            autocomplete: "off" %>
      </div>
      <%= f.submit "Search", 
          class: "px-6 py-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600 transition duration-200" %>
    <% end %>
  </div>

  <!-- Results Grid -->
  <% if @artists.present? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <% @artists.each do |artist| %>
        <%= link_to artist_path(artist['id']), class: "block" do %>
          <div class="glass-effect rounded-lg overflow-hidden hover-glow">
            <div class="aspect-square">
              <% if artist['picture_medium'] %>
                <%= image_tag artist['picture_medium'], alt: "#{artist['name']} picture", class: "object-cover w-full h-full" %>
              <% else %>
                <div class="w-full h-full bg-gray-800 flex items-center justify-center">
                  <svg class="w-12 h-12 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="p-3">
              <h3 class="font-medium truncate" title="<%= artist['name'] %>"><%= artist['name'] %></h3>
              <p class="text-gray-400 text-sm"><%= pluralize(artist['nb_fan'] || 0, 'fan') %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% elsif params[:query].present? %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-2">
        No artists found for "<%= params[:query] %>"
      </div>
      <p class="text-gray-500 text-sm">
        Try different keywords or check your spelling
      </p>
    </div>
  <% end %>
</div> 