<div class="min-h-screen bg-gradient-to-br from-indigo-950 to-cyan-800">
  <%= render 'shared/sidebar' %>
  
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-y-auto px-4 ml-16 md:ml-64">
    <!-- Top Navigation Bar -->
    <%= render 'shared/topbar' %>

    <div class="py-6">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2">Your Albums</h1>
        <p class="text-gray-300">Browse your saved albums and collections</p>
      </div>

      <!-- Filter Controls -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-4">
          <div class="relative">
            <input type="text" placeholder="Filter albums" class="bg-indigo-900/50 backdrop-blur-sm py-1.5 pl-8 pr-4 rounded-full text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400 border border-cyan-900/40">
            <svg class="absolute left-2.5 top-2 w-4 h-4 text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </div>
          <select class="bg-indigo-900/50 backdrop-blur-sm py-1.5 px-4 rounded-full text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400 border border-cyan-900/40">
            <option>Recently Added</option>
            <option>Alphabetical</option>
            <option>Artist</option>
          </select>
        </div>
        <div class="flex space-x-2">
          <button class="bg-indigo-900/50 backdrop-blur-sm p-1.5 rounded-md border border-cyan-900/30">
            <svg class="w-5 h-5 text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 9h4V5H3v4zm0 5h4v-4H3v4zm0 5h4v-4H3v4zm5 0h4v-4H8v4zm5 0h4v-4h-4v4zM8 9h4V5H8v4zm5 0h4V5h-4v4zm5 0h4V5h-4v4zm0 5h4v-4h-4v4zM8 14h4v-4H8v4zm5 0h4v-4h-4v4z"/>
            </svg>
          </button>
          <button class="bg-cyan-600/80 backdrop-blur-sm p-1.5 rounded-md border border-cyan-900/30">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4 11h5V5H4v6zm0 7h5v-6H4v6zm6 0h5v-6h-5v6zm6 0h4v-6h-4v6zm0-13v6h4V5h-4zm-6 6h5V5h-5v6z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Albums Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
        <% if @library_albums['data'] %>
          <% @library_albums['data'].each do |album| %>
            <!-- Album Card -->
            <div class="bg-indigo-900/40 backdrop-blur-sm border border-cyan-900/20 rounded-lg overflow-hidden transition-transform hover:scale-105 shadow-md" data-controller="song-element">
              <div class="relative">
                <img src="<%= album['cover_medium'] %>" class="w-full aspect-square object-cover" alt="<%= album['title'] %>">
                <button class="absolute right-2 bottom-2 bg-cyan-600 bg-opacity-90 p-2 rounded-full cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity"
                        data-action="click->song-element#playSong"
                        data-song-element-song-value="<%= { 
                          id: album['id'], 
                          title: album['title'], 
                          artist: { name: album['artist']['name'], id: album['artist']['id'] }, 
                          album: { 
                            title: album['title'], 
                            cover_medium: album['cover_medium'] 
                          }, 
                          preview: album['tracks'] && album['tracks']['data'] && album['tracks']['data'].first ? album['tracks']['data'].first['preview'] : '' 
                        }.to_json %>">
                  <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
              <div class="p-3">
                <h3 class="font-medium truncate"><%= album['title'] %></h3>
                <p class="text-gray-400 text-sm truncate"><%= album['artist']['name'] %></p>
                <p class="text-xs text-cyan-400 mt-1">
                  <%= album['release_date'] ? album['release_date'].split('-').first : "Album" %>
                </p>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- Empty State -->
          <div class="col-span-full flex flex-col items-center justify-center py-16">
            <svg class="w-16 h-16 text-indigo-800" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5z"/>
            </svg>
            <h3 class="mt-4 text-xl font-medium">No albums saved yet</h3>
            <p class="mt-2 text-gray-400">Browse and save albums to build your collection</p>
            <button class="mt-4 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold py-2 px-6 rounded-full transition shadow-md">
              Browse Albums
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  
  <!-- Player Bar -->
  <%= render 'shared/player' %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Albums page DOM loaded');
    
    // Set user interaction flag for autoplay
    document.documentElement.setAttribute('data-user-interacted', 'true');
  });
</script> 