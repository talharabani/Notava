<div class="min-h-screen bg-gradient-to-br from-indigo-950 to-cyan-800">
  <%= render 'shared/sidebar' %>
  
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-y-auto px-4 ml-16 md:ml-64">
    <!-- Top Navigation Bar -->
    <%= render 'shared/topbar' %>

    <div class="py-6">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2">Your Artists</h1>
        <p class="text-gray-300">Browse your favorite and followed artists</p>
      </div>

      <!-- Filter Controls -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-4">
          <div class="relative">
            <input type="text" placeholder="Filter artists" class="bg-indigo-900/50 backdrop-blur-sm py-1.5 pl-8 pr-4 rounded-full text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400 border border-cyan-900/40">
            <svg class="absolute left-2.5 top-2 w-4 h-4 text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </div>
          <select class="bg-indigo-900/50 backdrop-blur-sm py-1.5 px-4 rounded-full text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400 border border-cyan-900/40">
            <option>Alphabetical</option>
            <option>Recently Added</option>
            <option>Most Played</option>
          </select>
        </div>
      </div>

      <!-- Artists Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <% if @library_artists.present? %>
          <% @library_artists.each do |artist| %>
            <!-- Artist Card -->
            <div class="bg-indigo-900/40 backdrop-blur-sm border border-cyan-900/20 rounded-lg overflow-hidden transition-transform hover:scale-105 shadow-md">
              <div class="relative">
                <% if artist['picture_medium'] %>
                  <img src="<%= artist['picture_medium'] %>" class="w-full aspect-square object-cover" alt="<%= artist['name'] %>">
                <% else %>
                  <div class="w-full aspect-square flex items-center justify-center bg-indigo-800/50">
                    <svg class="w-24 h-24 text-indigo-300/50" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                <% end %>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent to-indigo-950/90 flex items-end">
                  <div class="p-4 w-full">
                    <h3 class="font-bold text-lg"><%= artist['name'] %></h3>
                    <p class="text-gray-300 text-sm"><%= artist['nb_fan'] ? "#{number_with_delimiter(artist['nb_fan'])} fans" : "Artist" %></p>
                  </div>
                </div>
              </div>
              
              <!-- Top Tracks -->
              <div class="p-3">
                <h4 class="text-sm font-medium text-cyan-400 mb-2">Top Tracks</h4>
                <% if artist['top_tracks'].present? %>
                  <ul class="space-y-2" data-controller="song-element">
                    <% artist['top_tracks'].first(3).each do |track| %>
                      <li class="flex items-center justify-between cursor-pointer hover:bg-indigo-800/30 rounded p-1 transition"
                          data-action="click->song-element#playSong"
                          data-song-element-song-value="<%= { 
                            id: track['id'], 
                            title: track['title'], 
                            artist: { name: artist['name'], id: artist['id'] }, 
                            album: { 
                              title: track['album']['title'], 
                              cover_medium: track['album']['cover_medium'] 
                            }, 
                            preview: track['preview'] 
                          }.to_json %>">
                        <div class="flex items-center">
                          <img src="<%= track['album']['cover_small'] %>" class="w-8 h-8 rounded object-cover mr-2" alt="<%= track['title'] %>">
                          <span class="text-sm truncate max-w-[120px]"><%= track['title_short'] %></span>
                        </div>
                        <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="text-gray-500 text-sm">No tracks available</p>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- Empty State -->
          <div class="col-span-full flex flex-col items-center justify-center py-16">
            <svg class="w-16 h-16 text-indigo-800" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
            <h3 class="mt-4 text-xl font-medium">No artists followed yet</h3>
            <p class="mt-2 text-gray-400">Follow artists to keep track of their new releases</p>
            <button class="mt-4 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold py-2 px-6 rounded-full transition shadow-md">
              Browse Artists
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  
  <!-- Player Bar -->
  <%= render 'shared/player' %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Artists page DOM loaded');
    
    // Set user interaction flag for autoplay
    document.documentElement.setAttribute('data-user-interacted', 'true');
  });
</script> 