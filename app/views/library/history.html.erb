<div class="min-h-screen bg-gradient-to-br from-indigo-950 to-cyan-800">
  <%= render 'shared/sidebar' %>
  
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-y-auto px-4 ml-16 md:ml-64">
    <!-- Top Navigation Bar -->
    <%= render 'shared/topbar' %>

    <div class="py-6">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2">Listening History</h1>
        <p class="text-gray-300">Track your listening habits and replay your favorites</p>
      </div>

      <!-- Recently Played Section -->
      <div class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold">Recently Played</h2>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
          <% if @recently_played['data'] %>
            <% @recently_played['data'].each do |track| %>
              <!-- Track Card -->
              <div class="bg-indigo-900/40 backdrop-blur-sm border border-cyan-900/20 rounded-lg overflow-hidden transition-transform hover:scale-105 shadow-md" data-controller="song-element">
                <div class="relative">
                  <img src="<%= track['album']['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= track['title'] %>"
                       data-action="click->song-element#playSong"
                       data-song-element-song-value="<%= { 
                         id: track['id'], 
                         title: track['title'], 
                         artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                         album: { 
                           title: track['album']['title'], 
                           cover_medium: track['album']['cover_medium'] 
                         }, 
                         preview: track['preview'] 
                       }.to_json %>">
                  <button class="absolute right-2 bottom-2 bg-gray-900 bg-opacity-70 p-2 rounded-full cursor-pointer"
                          data-action="click->song-element#playSong">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
                <div class="p-3 cursor-pointer"
                     data-action="click->song-element#playSong">
                  <h3 class="font-medium truncate"><%= track['title'] %></h3>
                  <p class="text-gray-400 text-sm truncate"><%= track['artist']['name'] %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Most Played Section -->
      <div class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold">Most Played</h2>
          <div class="flex items-center space-x-3">
            <select class="bg-indigo-900/50 backdrop-blur-sm py-1.5 px-4 rounded-full text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400 border border-cyan-900/40">
              <option>This Month</option>
              <option>Last 6 Months</option>
              <option>All Time</option>
            </select>
          </div>
        </div>
        
        <!-- Most Played Tracks Table -->
        <div class="bg-indigo-900/30 backdrop-blur-sm rounded-lg border border-cyan-900/20 overflow-hidden shadow-md mb-8">
          <table class="min-w-full divide-y divide-cyan-900/30">
            <thead class="bg-indigo-950/50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cyan-300 uppercase tracking-wider w-10">#</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cyan-300 uppercase tracking-wider">Title</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cyan-300 uppercase tracking-wider">Artist</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cyan-300 uppercase tracking-wider">Album</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cyan-300 uppercase tracking-wider text-center w-24">Plays</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cyan-300 uppercase tracking-wider w-16"></th>
              </tr>
            </thead>
            <tbody class="bg-indigo-900/10 divide-y divide-cyan-900/30" data-controller="song-element">
              <% if @most_played['data'] %>
                <% @most_played['data'].each_with_index do |track, index| %>
                  <tr class="hover:bg-indigo-800/30 cursor-pointer transition"
                      data-action="click->song-element#playSong"
                      data-song-element-song-value="<%= { 
                        id: track['id'], 
                        title: track['title'], 
                        artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                        album: { 
                          title: track['album']['title'], 
                          cover_medium: track['album']['cover_medium'] 
                        }, 
                        preview: track['preview'] 
                      }.to_json %>">
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-400"><%= index + 1 %></td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      <div class="flex items-center">
                        <img src="<%= track['album']['cover_medium'] %>" class="w-10 h-10 rounded object-cover mr-3" alt="<%= track['title'] %>">
                        <span class="font-medium"><%= track['title'] %></span>
                      </div>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-300"><%= track['artist']['name'] %></td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-300 truncate max-w-xs"><%= track['album']['title'] %></td>
                    <td class="px-4 py-3 whitespace-nowrap text-center">
                      <span class="bg-cyan-500/20 text-cyan-300 py-1 px-2 rounded-full text-xs font-medium">
                        <%= rand(5..50) %> plays
                      </span>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-right">
                      <button class="text-gray-400 hover:text-cyan-400">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                        </svg>
                      </button>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- Listening Timeline Section -->
      <div class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold">Listening Timeline</h2>
        </div>
        
        <div class="space-y-6">
          <% if @listening_days.present? %>
            <% @listening_days.each do |day| %>
              <div class="bg-indigo-900/30 backdrop-blur-sm rounded-lg border border-cyan-900/20 overflow-hidden shadow-md">
                <div class="bg-indigo-950/50 px-4 py-3 flex items-center justify-between">
                  <h3 class="font-medium"><%= day['formatted_date'] %></h3>
                  <span class="text-sm text-cyan-400"><%= day['track_count'] %> tracks played</span>
                </div>
                
                <div class="divide-y divide-cyan-900/30" data-controller="song-element">
                  <% day['tracks'].each do |track| %>
                    <div class="flex items-center justify-between p-3 hover:bg-indigo-800/30 cursor-pointer transition"
                         data-action="click->song-element#playSong"
                         data-song-element-song-value="<%= { 
                           id: track['id'], 
                           title: track['title'], 
                           artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                           album: { 
                             title: track['album']['title'], 
                             cover_medium: track['album']['cover_medium'] 
                           }, 
                           preview: track['preview'] 
                         }.to_json %>">
                      <div class="flex items-center">
                        <img src="<%= track['album']['cover_medium'] %>" class="w-12 h-12 rounded object-cover mr-3" alt="<%= track['title'] %>">
                        <div>
                          <h4 class="font-medium"><%= track['title'] %></h4>
                          <p class="text-gray-400 text-sm"><%= track['artist']['name'] %></p>
                        </div>
                      </div>
                      <div class="flex items-center">
                        <span class="text-gray-400 text-sm mr-3"><%= rand(8..23) %>:<%= sprintf('%02d', rand(0..59)) %></span>
                        <button class="text-gray-400 hover:text-cyan-400 p-1">
                          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M8 5v14l11-7z"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="bg-indigo-900/30 backdrop-blur-sm rounded-lg border border-cyan-900/20 p-8 text-center">
              <p class="text-gray-400">No listening history available yet. Start playing some tracks!</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Player Bar -->
  <%= render 'shared/player' %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('History page DOM loaded');
    
    // Set user interaction flag for autoplay
    document.documentElement.setAttribute('data-user-interacted', 'true');
  });
</script> 