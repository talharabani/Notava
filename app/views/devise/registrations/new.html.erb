<div class="min-h-screen bg-[#0d1b2a] flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-[#1b263b] p-6 rounded-2xl shadow-xl">
    <h2 class="text-2xl font-bold text-center text-[#e0e1dd] mb-6">
      Sign up
    </h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <%= f.label :email, class: "block text-[#e0e1dd] mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 rounded-lg bg-[#415a77] text-white placeholder:text-gray-300 border-none" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "block text-[#e0e1dd] mb-1" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-1">(<%= @minimum_password_length %> characters minimum)</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2 rounded-lg bg-[#415a77] text-white placeholder:text-gray-300 border-none" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, class: "block text-[#e0e1dd] mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2 rounded-lg bg-[#415a77] text-white placeholder:text-gray-300 border-none" %>
      </div>

      <div class="text-center">
        <%= f.submit "Sign up", class: "bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-6 rounded-full transition" %>
      </div>
    <% end %>

    <div class="mt-4 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
