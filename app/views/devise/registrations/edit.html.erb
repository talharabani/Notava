<div class="min-h-screen bg-[#0d1b2a] flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-[#1b263b] p-6 rounded-2xl shadow-xl">
    <h2 class="text-2xl font-bold text-center text-[#e0e1dd] mb-6">
      Edit <%= resource_name.to_s.humanize %>
    </h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <%= f.label :email, class: "block text-[#e0e1dd] mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 rounded-lg bg-[#415a77] text-white placeholder:text-gray-300 border-none" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="mb-4 text-sm text-yellow-400">
          Currently waiting confirmation for: <%= resource.unconfirmed_email %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :password, class: "block text-[#e0e1dd] mb-1" %>
        <p class="text-sm text-gray-400 mb-1">(leave blank if you don't want to change it)</p>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2 rounded-lg bg-[#415a77] text-white placeholder:text-gray-300 border-none" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mt-1">
            <%= @minimum_password_length %> characters minimum
          </p>
        <% end %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, class: "block text-[#e0e1dd] mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2 rounded-lg bg-[#415a77] text-white placeholder:text-gray-300 border-none" %>
      </div>

      <div class="mb-6">
        <%= f.label :current_password, class: "block text-[#e0e1dd] mb-1" %>
        <p class="text-sm text-gray-400 mb-1">(we need your current password to confirm your changes)</p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-2 rounded-lg bg-[#415a77] text-white placeholder:text-gray-300 border-none" %>
      </div>

      <div class="text-center">
        <%= f.submit "Update", class: "bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-6 rounded-full transition" %>
      </div>
    <% end %>

    <div class="mt-8 border-t border-gray-600 pt-6">
      <h3 class="text-xl font-semibold text-red-400 mb-2">Cancel my account</h3>
      <p class="text-gray-300 mb-4">Unhappy?</p>
      <%= button_to "Cancel my account", registration_path(resource_name), method: :delete, data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-full" %>
    </div>

    <div class="mt-4 text-center">
      <%= link_to "Back", :back, class: "text-blue-400 hover:text-blue-500 transition" %>
    </div>
  </div>
</div>
