<div class="min-h-screen bg-gradient-to-br from-indigo-950 to-cyan-800" data-controller="playlist">
  <%= render 'shared/sidebar' %>
  
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-y-auto px-4 ml-16 md:ml-64">
    <!-- Top Navigation Bar -->
    <%= render 'shared/topbar' %>

    <div class="py-6">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2">New Releases</h1>
        <p class="text-gray-300">Explore the latest music releases updated weekly</p>
      </div>

      <!-- New Tracks Section -->
      <div class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold">New Tracks</h2>
          <div class="flex items-center space-x-3">
            <span class="text-sm text-gray-400">Updated <%= Date.today.strftime("%b %d") %></span>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% if @new_tracks['data'] %>
            <% @new_tracks['data'].each do |track| %>
              <!-- Track Card -->
              <div class="bg-gradient-to-br from-indigo-900/60 to-cyan-900/30 backdrop-blur-sm rounded-xl overflow-hidden hover:shadow-lg hover:shadow-cyan-900/20 transition-all duration-300 border border-cyan-800/30" data-controller="song-element">
                <div class="relative group">
                  <img src="<%= track['album']['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= track['title'] %>"
                       data-action="click->song-element#playSong"
                       data-song-element-song-value="<%= { 
                         id: track['id'], 
                         title: track['title'], 
                         artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                         album: { 
                           title: track['album']['title'], 
                           cover_medium: track['album']['cover_medium'] 
                         }, 
                         preview: track['preview'] 
                       }.to_json %>">
                  <div class="absolute inset-0 bg-gradient-to-t from-indigo-950/90 via-indigo-950/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  <div class="absolute top-2 left-2 bg-gradient-to-r from-cyan-500 to-cyan-400 text-xs px-2 py-1 rounded-full text-indigo-950 font-medium shadow-md">
                    New
                  </div>
                  <div class="absolute right-2 bottom-2 flex space-x-1.5">
                    <button class="bg-gradient-to-r from-indigo-900/80 to-cyan-900/70 backdrop-blur-sm p-2 rounded-full cursor-pointer shadow-md opacity-0 group-hover:opacity-100 transition-all scale-90 group-hover:scale-100"
                            data-action="click->playlist#showAddToPlaylistModal"
                            data-track-id="<%= track['id'] %>">
                      <svg class="w-5 h-5 text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M14 10H2v2h12v-2zm0-4H2v2h12V6zm4 8v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zM2 16h8v-2H2v2z"/>
                      </svg>
                    </button>
                    <button class="bg-gradient-to-r from-cyan-500 to-cyan-400 p-2 rounded-full cursor-pointer shadow-md opacity-0 group-hover:opacity-100 transition-all scale-90 group-hover:scale-100"
                            data-action="click->song-element#playSong">
                      <svg class="w-5 h-5 text-indigo-950" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="p-4 cursor-pointer"
                     data-action="click->song-element#playSong">
                  <h3 class="font-medium truncate"><%= track['title'] %></h3>
                  <p class="text-cyan-300 text-sm truncate"><%= track['artist']['name'] %></p>
                  <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs bg-indigo-800/50 text-cyan-300 px-2 py-0.5 rounded-full">Track</span>
                    <span class="text-xs text-cyan-400"><%= track['duration'] ? "#{track['duration'] / 60}:#{(track['duration'] % 60).to_s.rjust(2, '0')}" : "0:30" %></span>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- New Albums Section -->
      <div class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold">New Albums</h2>
          <div class="flex items-center space-x-3">
            <span class="text-sm text-gray-400">Updated <%= Date.today.strftime("%b %d") %></span>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% if @new_albums['data'] %>
            <% @new_albums['data'].each do |album| %>
              <!-- Album Card -->
              <div class="bg-gradient-to-br from-indigo-900/60 to-cyan-900/30 backdrop-blur-sm rounded-xl overflow-hidden hover:shadow-lg hover:shadow-cyan-900/20 transition-all duration-300 border border-cyan-800/30" data-controller="song-element">
                <div class="relative group">
                  <img src="<%= album['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= album['title'] %>"
                       data-action="click->song-element#playSong"
                       data-song-element-song-value="<%= { 
                         id: album['id'], 
                         title: album['title'], 
                         artist: { name: album['artist']['name'], id: album['artist']['id'] }, 
                         album: { 
                           title: album['title'], 
                           cover_medium: album['cover_medium'] 
                         }, 
                         preview: album['tracks'] && album['tracks']['data'] && album['tracks']['data'].first ? album['tracks']['data'].first['preview'] : '' 
                       }.to_json %>">
                  <div class="absolute inset-0 bg-gradient-to-t from-indigo-950/90 via-indigo-950/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  <div class="absolute top-2 left-2 bg-gradient-to-r from-cyan-500 to-cyan-400 text-xs px-2 py-1 rounded-full text-indigo-950 font-medium shadow-md">
                    Album
                  </div>
                  <div class="absolute right-2 bottom-2 flex space-x-1.5">
                    <button class="bg-gradient-to-r from-indigo-900/80 to-cyan-900/70 backdrop-blur-sm p-2 rounded-full cursor-pointer shadow-md opacity-0 group-hover:opacity-100 transition-all scale-90 group-hover:scale-100"
                            data-action="click->playlist#showAddToPlaylistModal"
                            data-track-id="<%= album['id'] %>">
                      <svg class="w-5 h-5 text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M14 10H2v2h12v-2zm0-4H2v2h12V6zm4 8v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zM2 16h8v-2H2v2z"/>
                      </svg>
                    </button>
                    <button class="bg-gradient-to-r from-cyan-500 to-cyan-400 p-2 rounded-full cursor-pointer shadow-md opacity-0 group-hover:opacity-100 transition-all scale-90 group-hover:scale-100"
                            data-action="click->song-element#playSong">
                      <svg class="w-5 h-5 text-indigo-950" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="p-4">
                  <h3 class="font-medium truncate"><%= album['title'] %></h3>
                  <p class="text-cyan-300 text-sm truncate"><%= album['artist']['name'] %></p>
                  <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs bg-indigo-800/50 text-cyan-300 px-2 py-0.5 rounded-full">
                      <%= album['tracks'] && album['tracks']['data'] ? "#{album['tracks']['data'].length} tracks" : "Album" %>
                    </span>
                    <span class="text-xs text-cyan-400">New Release</span>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Player Bar -->
  <%= render 'shared/player' %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('New Releases page DOM loaded');
    
    // Set user interaction flag for autoplay
    document.documentElement.setAttribute('data-user-interacted', 'true');
  });
</script>