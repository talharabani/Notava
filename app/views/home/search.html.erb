<div class="min-h-screen bg-gradient-to-br from-gray-900 to-pink-500">

<div class="flex h-screen bg-gray-900 text-white">
  <!-- Sidebar Navigation -->
  <div class="w-16 md:w-64 bg-black flex-shrink-0 overflow-y-auto">
    <div class="p-4">
      <div class="flex items-center mb-6">
        <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/>
        </svg>
        <span class="text-xl font-bold ml-2 hidden md:block">Notava</span>
      </div>

      <div class="space-y-6">
        <!-- Discover Section -->
        <div>
          <p class="text-xs text-gray-400 mb-2 hidden md:block">BROWSE</p>
          <ul class="space-y-3">
            <li>
              <a href="<%= root_path %>" class="flex items-center py-1 text-gray-300 hover:text-white">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 10.9c-.61 0-1.1.49-1.1 1.1s.49 1.1 1.1 1.1c.61 0 1.1-.49 1.1-1.1s-.49-1.1-1.1-1.1zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm2.19 12.19L6 18l3.81-8.19L18 6l-3.81 8.19z"/>
                </svg>
                <span class="ml-3 hidden md:block">Discover</span>
              </a>
            </li>
            <li>
              <a href="#" class="flex items-center py-1 text-gray-300 hover:text-white">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                </svg>
                <span class="ml-3 hidden md:block">New Releases</span>
              </a>
            </li>
            <li>
              <a href="#" class="flex items-center py-1 text-gray-300 hover:text-white">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 6v8h3v-8h-3zm-5 8h3V6h-3v8zm-5 0h3V6H6v8zM2 20h20v-2H2v2zm0-10V4h20v6H2z"/>
                </svg>
                <span class="ml-3 hidden md:block">Popular</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Your Music Section -->
        <div>
          <p class="text-xs text-gray-400 mb-2 hidden md:block">YOUR MUSIC</p>
          <ul class="space-y-3">
            <li>
              <a href="#" class="flex items-center py-1 text-gray-300 hover:text-white">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                </svg>
                <span class="ml-3 hidden md:block">Songs</span>
              </a>
            </li>
            <li>
              <a href="#" class="flex items-center py-1 text-gray-300 hover:text-white">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5z"/>
                </svg>
                <span class="ml-3 hidden md:block">Albums</span>
              </a>
            </li>
            <li>
              <a href="#" class="flex items-center py-1 text-gray-300 hover:text-white">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
                <span class="ml-3 hidden md:block">Artists</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-y-auto px-4">
    <!-- Top Navigation Bar -->
    <div class="bg-gray-900 py-2 flex items-center justify-between border-b border-gray-800">
      <div class="relative flex items-center flex-1 max-w-3xl mx-4" data-controller="search">
        <%= form_with url: search_path, method: :get, class: "w-full", data: { turbo_frame: "search_results", action: "submit->search#submit" } do |f| %>
          <div class="relative">
            <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
            <%= f.text_field :query, value: params[:query], placeholder: "Search for songs, artists, or albums", 
                             class: "bg-gray-800 py-2 pl-10 pr-4 rounded-full w-full text-sm focus:outline-none focus:ring-1 focus:ring-blue-500", 
                             data: { action: "input->search#search keydown->search#handleKeydown", search_target: "input" }, 
                             autocomplete: "off" %>
          </div>
          <div id="search_dropdown" class="hidden absolute left-0 right-0 mt-2 bg-gray-800 rounded-lg shadow-lg overflow-hidden z-50 max-h-96 overflow-y-auto" data-search-target="dropdown">
            <div id="search_results" class="p-2">
              <!-- Search results will appear here -->
            </div>
          </div>
        <% end %>
      </div>
      <div class="flex items-center space-x-4">
        <% if user_signed_in? %>
          <%= link_to "Upgrade", plans_path, class: "bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-6 rounded-full transition" %>
          
          <!-- Profile Dropdown -->
          <div class="relative" data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center space-x-2 text-gray-300 hover:text-white transition">
              <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                </svg>
              </div>
            </button>

            <!-- Dropdown Menu -->
            <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-gray-800 rounded-lg shadow-lg py-1 z-50">
              <div class="px-4 py-2 text-sm text-gray-300 border-b border-gray-700">
                <%= current_user.email %>
              </div>
              <%= link_to "Profile", "#", class: "block px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition" %>
              <%= link_to "Settings", "#", class: "block px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition" %>
              <div class="border-t border-gray-700 my-1"></div>
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition" %>
            </div>
          </div>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "text-gray-300 hover:text-white transition" %>
          <%= link_to "Upgrade", plans_path, class: "bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-6 rounded-full transition" %>
        <% end %>
      </div>
    </div>

    <!-- Search Results -->
    <div class="py-6">
      <h1 class="text-2xl font-bold mb-6">Search Results for "<%= params[:query] %>"</h1>
      
      <% if @results['data'].present? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @results['data'].each do |track| %>
            <div class="bg-gray-800 rounded-lg overflow-hidden flex items-center p-3 hover:bg-gray-700 transition cursor-pointer"
                 data-controller="song-element"
                 data-song-element-song-value="<%= { 
                   id: track['id'], 
                   title: track['title'], 
                   artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                   album: { 
                     title: track['album']['title'], 
                     cover_medium: track['album']['cover_medium'] 
                   }, 
                   preview: track['preview'] 
                 }.to_json %>"
                 data-action="click->song-element#playSong">
              <img src="<%= track['album']['cover_medium'] %>" class="w-16 h-16 object-cover rounded mr-4 cursor-pointer" alt="<%= track['title'] %>">
              <div class="flex-1 min-w-0">
                <h3 class="font-medium truncate"><%= track['title'] %></h3>
                <p class="text-gray-400 text-sm truncate"><%= track['artist']['name'] %></p>
                <p class="text-gray-500 text-xs truncate"><%= track['album']['title'] %></p>
              </div>
              <button class="ml-4 bg-gray-900 bg-opacity-70 p-2 rounded-full cursor-pointer"
                      data-action="click->song-element#playSong">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-gray-800 rounded-lg p-8 text-center">
          <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
          <h2 class="text-xl font-semibold mb-2">No results found</h2>
          <p class="text-gray-400">Try searching for something else</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Player Bar -->
<div id="player-bar" class="fixed bottom-0 left-0 right-0 bg-gray-800 border-t border-gray-700 p-4 z-50" data-controller="player">
  <!-- Audio element is created dynamically in JavaScript -->
  
  <div class="container mx-auto flex items-center justify-between">
    <!-- Song Info -->
    <div class="flex items-center w-1/4">
      <img src="" alt="Album Cover" class="album-cover w-12 h-12 object-cover rounded mr-3">
      <div>
        <h4 class="song-title text-sm font-medium">Select a song to play</h4>
        <p class="artist-name text-xs text-gray-400">-</p>
      </div>
    </div>
    
    <!-- Player Controls -->
    <div class="flex flex-col items-center w-2/4">
      <div class="flex items-center space-x-4 mb-2">
        <!-- Shuffle Button -->
        <button class="text-gray-400 hover:text-white cursor-pointer" data-action="click->player#toggleShuffle">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm0.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/>
          </svg>
        </button>
        
        <!-- Previous Button -->
        <button class="text-gray-400 hover:text-white cursor-pointer" data-action="click->player#previous">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
          </svg>
        </button>
        
        <!-- Play/Pause Button -->
        <button class="text-black bg-white rounded-full p-2 hover:bg-gray-200 cursor-pointer" data-action="click->player#togglePlay">
          <svg class="w-6 h-6" data-player-target="playIcon" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg class="w-6 h-6 hidden" data-player-target="pauseIcon" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
        </button>
        
        <!-- Next Button -->
        <button class="text-gray-400 hover:text-white cursor-pointer" data-action="click->player#next">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
          </svg>
        </button>
        
        <!-- Repeat Button -->
        <button class="text-gray-400 hover:text-white cursor-pointer" data-action="click->player#toggleRepeat">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/>
          </svg>
        </button>
      </div>
      
      <!-- Progress Bar -->
      <div class="w-full flex items-center space-x-2">
        <span class="current-time text-xs text-gray-400">0:00</span>
        <div class="flex-1 h-1 bg-gray-700 rounded-full cursor-pointer" data-action="click->player#seek">
          <div class="h-full bg-pink-500 rounded-full" data-player-target="progressBar" style="width: 0%"></div>
        </div>
        <span class="duration text-xs text-gray-400">0:00</span>
      </div>
    </div>
    
    <!-- Volume Control -->
    <div class="flex items-center w-1/4 justify-end">
      <svg class="w-5 h-5 text-gray-400 mr-2" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
      </svg>
      <div class="w-24 h-1 bg-gray-700 rounded-full cursor-pointer" data-action="click->player#adjustVolume">
        <div class="h-full bg-gray-400 rounded-full volume-bar" data-player-target="volumeBar" style="width: 70%"></div>
      </div>
    </div>
  </div>
</div>
</div> 

<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Search page DOM loaded');
    
    // Set user interaction flag for autoplay
    document.documentElement.setAttribute('data-user-interacted', 'true');
    
    // Find all song play buttons
    const playButtons = document.querySelectorAll('[data-action="click->player#playSong"]');
    console.log('Play buttons found on search page:', playButtons.length);
    
    // Make sure the player controller is connected to each play button
    if (playButtons.length > 0) {
      // Get the player controller instance
      const playerBar = document.getElementById('player-bar');
      
      if (playerBar) {
        // Wait a bit to ensure controllers are initialized
        setTimeout(() => {
          // Check if player controller exists
          if (window.playerController) {
            console.log('Global player controller found, ready to play songs');
          } else {
            console.warn('Global player controller not found, trying to initialize');
            
            // Try to find Stimulus application and player controller
            const application = window.Stimulus;
            if (application) {
              const playerController = application.getControllerForElementAndIdentifier(playerBar, 'player');
              if (playerController) {
                window.playerController = playerController;
                console.log('Player controller initialized from Stimulus application');
              }
            }
          }
          
          // Add click event listeners to all play buttons for proper handling
          playButtons.forEach((button, index) => {
            // Ensure the click event properly triggers playSong
            button.addEventListener('click', function(event) {
              console.log(`Search page: Play button ${index} clicked`);
              
              // If the Stimulus controller didn't handle it, handle it manually
              if (window.playerController && !event.defaultPrevented) {
                const songData = this.dataset.song;
                if (songData) {
                  console.log('Manually playing song via playerController');
                  
                  // Create a synthetic event
                  const customEvent = new CustomEvent('click', {
                    bubbles: true,
                    cancelable: true
                  });
                  
                  // Add the dataset property to the event
                  Object.defineProperty(customEvent, 'currentTarget', {
                    value: {
                      dataset: {
                        song: songData
                      }
                    },
                    writable: false
                  });
                  
                  // Call the playSong method on the player controller
                  window.playerController.playSong(customEvent);
                }
              }
            });
            
            // Check for missing preview URLs
            const songData = button.dataset.song;
            if (songData) {
              try {
                const song = JSON.parse(songData);
                if (!song.preview) {
                  console.warn(`Button ${index} has no preview URL:`, song);
                }
              } catch (e) {
                console.error(`Error parsing song data for button ${index}:`, e);
              }
            }
          });
        }, 500); // Wait 500ms to ensure everything is loaded
      } else {
        console.error('Player bar element not found on the page');
      }
    } else {
      console.warn('No play buttons found on the search page');
    }
  });
</script> 