        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% if @chart_tracks['data'] %>
            <% @chart_tracks['data'].each do |track| %>
              <!-- Track Card -->
              <div class="bg-gray-800 rounded-lg overflow-hidden transition-transform hover:scale-105">
                <div class="relative">
                  <img src="<%= track['album']['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= track['title'] %>"
