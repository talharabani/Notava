      <!-- Popular Tracks Section -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold">Popular Tracks</h2>
          <div class="flex space-x-2">
            <!-- Removed navigation buttons as they're not functional -->
