<div class="min-h-screen bg-gradient-to-br from-indigo-950 to-cyan-800">
  <%= render 'shared/sidebar' %>
  
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-y-auto px-4 ml-16 md:ml-64">
    <!-- Top Navigation Bar -->
    <%= render 'shared/topbar' %>

    <div class="py-6">
      <!-- New Music Friday -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold">New Music Friday</h2>
          <div class="flex space-x-2">
            <!-- Removed navigation buttons as they're not functional -->
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% if @new_friday_tracks['data'] %>
            <% @new_friday_tracks['data'].each do |track| %>
              <!-- Track Card -->
              <div class="bg-indigo-900/40 backdrop-blur-sm border border-cyan-900/20 rounded-lg overflow-hidden transition-transform hover:scale-105 shadow-md" data-controller="song-element">
                <div class="relative">
                  <img src="<%= track['album']['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= track['title'] %>"
                       data-action="click->song-element#playSong"
                       data-song-element-song-value="<%= { 
                         id: track['id'], 
                         title: track['title'], 
                         artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                         album: { 
                           title: track['album']['title'], 
                           cover_medium: track['album']['cover_medium'] 
                         }, 
                         preview: track['preview'] 
                       }.to_json %>">
                  <button class="absolute right-2 bottom-2 bg-gray-900 bg-opacity-70 p-2 rounded-full cursor-pointer"
                          data-action="click->song-element#playSong">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
                <div class="p-3 cursor-pointer"
                     data-action="click->song-element#playSong">
                  <h3 class="font-medium truncate"><%= track['title'] %></h3>
                  <p class="text-gray-400 text-sm truncate"><%= track['artist']['name'] %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Trending Tracks Section -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold">Trending Tracks</h2>
          <a href="<%= popular_path %>" class="text-cyan-400 hover:text-cyan-300 text-sm font-medium">See All</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% if @trending_tracks['data'] %>
            <% @trending_tracks['data'].each do |track| %>
              <!-- Track Card -->
              <div class="bg-indigo-900/40 backdrop-blur-sm border border-cyan-900/20 rounded-lg overflow-hidden transition-transform hover:scale-105 shadow-md" data-controller="song-element">
                <div class="relative">
                  <img src="<%= track['album']['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= track['title'] %>"
                       data-action="click->song-element#playSong"
                       data-song-element-song-value="<%= { 
                         id: track['id'], 
                         title: track['title'], 
                         artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                         album: { 
                           title: track['album']['title'], 
                           cover_medium: track['album']['cover_medium'] 
                         }, 
                         preview: track['preview'] 
                       }.to_json %>">
                  <button class="absolute right-2 bottom-2 bg-gray-900 bg-opacity-70 p-2 rounded-full cursor-pointer"
                          data-action="click->song-element#playSong">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
                <div class="p-3 cursor-pointer"
                     data-action="click->song-element#playSong">
                  <h3 class="font-medium truncate"><%= track['title'] %></h3>
                  <p class="text-gray-400 text-sm truncate"><%= track['artist']['name'] %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Popular Tracks Section -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold">Popular Tracks</h2>
          <a href="<%= charts_path %>" class="text-cyan-400 hover:text-cyan-300 text-sm font-medium">See Charts</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% if @chart_tracks['data'] %>
            <% @chart_tracks['data'].each do |track| %>
              <!-- Track Card -->
              <div class="bg-indigo-900/40 backdrop-blur-sm border border-cyan-900/20 rounded-lg overflow-hidden transition-transform hover:scale-105 shadow-md" data-controller="song-element">
                <div class="relative">
                  <img src="<%= track['album']['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= track['title'] %>"
                       data-action="click->song-element#playSong"
                       data-song-element-song-value="<%= { 
                         id: track['id'], 
                         title: track['title'], 
                         artist: { name: track['artist']['name'], id: track['artist']['id'] }, 
                         album: { 
                           title: track['album']['title'], 
                           cover_medium: track['album']['cover_medium'] 
                         }, 
                         preview: track['preview'] 
                       }.to_json %>">
                  <button class="absolute right-2 bottom-2 bg-gray-900 bg-opacity-70 p-2 rounded-full cursor-pointer"
                          data-action="click->song-element#playSong">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
                <div class="p-3 cursor-pointer"
                     data-action="click->song-element#playSong">
                  <h3 class="font-medium truncate"><%= track['title'] %></h3>
                  <p class="text-gray-400 text-sm truncate"><%= track['artist']['name'] %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Popular Albums Section -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold">Popular Albums</h2>
          <a href="<%= albums_path %>" class="text-cyan-400 hover:text-cyan-300 text-sm font-medium">See Library</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% if @popular_albums['data'] %>
            <% @popular_albums['data'].each do |album| %>
              <!-- Album Card -->
              <div class="bg-indigo-900/40 backdrop-blur-sm border border-cyan-900/20 rounded-lg overflow-hidden transition-transform hover:scale-105 shadow-md" data-controller="song-element">
                <div class="relative">
                  <img src="<%= album['cover_medium'] %>" class="w-full aspect-square object-cover cursor-pointer" alt="<%= album['title'] %>"
                       data-action="click->song-element#playSong"
                       data-song-element-song-value="<%= { 
                         id: album['id'], 
                         title: album['title'], 
                         artist: { name: album['artist']['name'], id: album['artist']['id'] }, 
                         album: { 
                           title: album['title'], 
                           cover_medium: album['cover_medium'] 
                         }, 
                         preview: album['tracks'] && album['tracks']['data'] && album['tracks']['data'].first ? album['tracks']['data'].first['preview'] : '' 
                       }.to_json %>">
                  <button class="absolute right-2 bottom-2 bg-gray-900 bg-opacity-70 p-2 rounded-full cursor-pointer" 
                          data-action="click->song-element#playSong">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
                <div class="p-3 cursor-pointer" 
                     data-action="click->song-element#playSong">
                  <h3 class="font-medium truncate"><%= album['title'] %></h3>
                  <p class="text-gray-400 text-sm truncate"><%= album['artist']['name'] %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>


      <!-- Genres Section -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold">Genres</h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 gap-4">
          <% if @genres['data'] %>
            <% colors = ['bg-blue-800/50', 'bg-purple-700/50', 'bg-cyan-700/50', 'bg-red-600/50', 'bg-green-700/50', 'bg-pink-700/50'] %>
            <% @genres['data'].first(9).each_with_index do |genre, index| %>
              <%= link_to genre_path(genre['id']), class: "#{colors[index % colors.length]} rounded-lg p-12 text-center transition-transform hover:scale-105 border border-white/10 backdrop-blur-sm hover:shadow-lg" do %>
                <h3 class="font-bold text-xl"><%= genre['name'] %></h3>
              <% end %>
            <% end %>
          <% else %>
            <!-- Fallback Genre Cards -->
            <div class="bg-blue-800/50 rounded-lg p-12 text-center transition-transform hover:scale-105 border border-white/10 backdrop-blur-sm">
              <h3 class="font-bold text-xl">Rock</h3>
            </div>
            <div class="bg-purple-700/50 rounded-lg p-12 text-center transition-transform hover:scale-105 border border-white/10 backdrop-blur-sm">
              <h3 class="font-bold text-xl">Electronic</h3>
            </div>
            <div class="bg-cyan-700/50 rounded-lg p-12 text-center transition-transform hover:scale-105 border border-white/10 backdrop-blur-sm">
              <h3 class="font-bold text-xl">Alternative</h3>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Player Bar -->
  <%= render 'shared/player' %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Home page DOM loaded');
    
    // Set user interaction flag for autoplay
    document.documentElement.setAttribute('data-user-interacted', 'true');
    
    // Initialize search dropdown
    const searchInput = document.querySelector('[data-search-target="input"]');
    if (searchInput) {
      // Focus the search input when pressing '/' key
      document.addEventListener('keydown', function(event) {
        // Check if not in an input or textarea element
        if (event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
          event.preventDefault();
          searchInput.focus();
        }
      });
      
      // Show suggestions on focus if no current search term
      searchInput.addEventListener('focus', function() {
        if (window.searchController && typeof window.searchController.showSuggestions === 'function') {
          window.searchController.showSuggestions();
        }
      });
    }
  });
</script>