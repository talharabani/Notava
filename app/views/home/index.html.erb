      <!-- Genres Section -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold">Genres</h2>
          <div class="flex space-x-2">
            <button class="p-1 rounded-full hover:bg-gray-700">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
              </svg>
            </button>
            <button class="p-1 rounded-full hover:bg-gray-700">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 gap-4">
          <% if @genres['data'] %>
            <% colors = ['bg-blue-800', 'bg-purple-700', 'bg-blue-600', 'bg-red-600', 'bg-teal-700', 'bg-green-800', 'bg-pink-700', 'bg-orange-600', 'bg-pink-600'] %>
            <% @genres['data'].first(9).each_with_index do |genre, index| %>
              <div class="<%= colors[index % colors.length] %> rounded-lg p-12 text-center transition-transform hover:scale-105">
                <h3 class="font-bold text-xl"><%= genre['name'] %></h3>
              </div>
            <% end %>
          <% else %>
            <!-- Fallback Genre Cards -->
            <div class="bg-blue-800 rounded-lg p-12 text-center transition-transform hover:scale-105">
              <h3 class="font-bold text-xl">Rock</h3>
            </div>
            <div class="bg-purple-700 rounded-lg p-12 text-center transition-transform hover:scale-105">
              <h3 class="font-bold text-xl">Electronic</h3>
            </div>
            <div class="bg-blue-600 rounded-lg p-12 text-center transition-transform hover:scale-105">
