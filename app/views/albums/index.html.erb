<div class="p-6">
  <!-- Search Form -->
  <div class="mb-8">
    <%= form_with url: albums_path, method: :get, class: "flex gap-4" do |f| %>
      <div class="flex-1">
        <%= f.text_field :query, 
            value: params[:query],
            class: "w-full px-4 py-2 rounded-lg bg-gray-800 text-white border border-gray-700 focus:border-pink-500 focus:ring-1 focus:ring-pink-500",
            placeholder: "Search for albums...",
            autocomplete: "off" %>
      </div>
      <%= f.submit "Search", 
          class: "px-6 py-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600 transition duration-200" %>
    <% end %>
  </div>

  <!-- Results Grid -->
  <% if @albums.present? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <% @albums.each do |album| %>
        <%= link_to album_path(album['id']), class: "block" do %>
          <div class="glass-effect rounded-lg overflow-hidden hover-glow">
            <div class="aspect-square">
              <% if album['cover_medium'] %>
                <%= image_tag album['cover_medium'], alt: "#{album['title']} cover", class: "object-cover w-full h-full" %>
              <% else %>
                <div class="w-full h-full bg-gray-800 flex items-center justify-center">
                  <svg class="w-12 h-12 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5z"/>
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="p-3">
              <h3 class="font-medium truncate" title="<%= album['title'] %>"><%= album['title'] %></h3>
              <p class="text-gray-400 text-sm truncate" title="<%= album['artist']['name'] %>"><%= album['artist']['name'] %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% elsif params[:query].present? %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-2">
        No albums found for "<%= params[:query] %>"
      </div>
      <p class="text-gray-500 text-sm">
        Try different keywords or check your spelling
      </p>
    </div>
  <% end %>
</div> 