<!-- Top Navigation Bar -->
<div class="bg-transparent py-4 flex items-center justify-between border-b border-cyan-900/30 relative">
  <div class="relative flex items-center flex-1 max-w-3xl mx-4" data-controller="search">
    <%= form_with url: search_path, method: :get, class: "w-full relative", data: { turbo_frame: "search_results", action: "submit->search#submit" } do |f| %>
      <div class="relative">
        <svg class="absolute left-3 top-2.5 w-4 h-4 text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
          <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
        <%= f.text_field :query, placeholder: "Search songs, artists, albums, or try 'pop', 'rock'...", 
                         class: "bg-indigo-900/50 backdrop-blur-sm py-2 pl-10 pr-10 rounded-full w-full text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400 border border-cyan-900/40", 
                         data: { action: "input->search#search keydown->search#handleKeydown", search_target: "input" }, 
                         autocomplete: "off" %>
        <button type="button" class="absolute right-3 top-2.5 w-4 h-4 text-gray-400 hover:text-cyan-300 transition-colors duration-150 hidden clear-search-btn" data-action="click->search#clearSearch">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </svg>
        </button>
      </div>
      <div id="search_dropdown" class="hidden fixed mt-2 bg-indigo-950/95 backdrop-blur-lg rounded-lg shadow-xl overflow-hidden z-[99999] max-h-96 overflow-y-auto border border-cyan-600/30" data-search-target="dropdown" style="min-width: 300px; width: 100%; max-width: 600px;">
        <div id="search_results" class="p-2">
          <!-- Search results will appear here -->
        </div>
      </div>
    <% end %>
  </div>
  <div class="flex items-center space-x-4">
    <% if user_signed_in? %>
      <%= link_to "Upgrade", plans_path, class: "bg-cyan-600 hover:bg-cyan-500 text-white font-semibold py-2 px-6 rounded-full transition shadow-md" %>
      
      <!-- Profile Dropdown -->
      <div class="relative" data-controller="dropdown">
        <button data-action="click->dropdown#toggle" class="flex items-center space-x-2 text-gray-300 hover:text-white transition">
          <div class="w-8 h-8 rounded-full bg-cyan-900/50 flex items-center justify-center border border-cyan-700/30">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
            </svg>
          </div>
        </button>

        <!-- Dropdown Menu -->
        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-indigo-900/90 backdrop-blur-sm rounded-lg shadow-lg py-1 z-50 border border-cyan-900/30">
          <div class="px-4 py-2 text-sm text-cyan-300 border-b border-cyan-900/30">
            <%= current_user.email %>
          </div>
          <%= link_to "Profile", profile_path, class: "block px-4 py-2 text-sm text-gray-300 hover:bg-indigo-800/50 hover:text-white transition" %>
          <%= link_to "Settings", "#", class: "block px-4 py-2 text-sm text-gray-300 hover:bg-indigo-800/50 hover:text-white transition" %>
          <div class="border-t border-cyan-900/30 my-1"></div>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-indigo-800/50 hover:text-white transition" %>
        </div>
      </div>
    <% else %>
      <%= link_to "Sign In", new_user_session_path, class: "text-gray-300 hover:text-white transition" %>
      <%= link_to "Upgrade", plans_path, class: "bg-cyan-600 hover:bg-cyan-500 text-white font-semibold py-2 px-6 rounded-full transition shadow-md" %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Handle clear button display
    const searchInputs = document.querySelectorAll('[data-search-target="input"]');
    
    searchInputs.forEach(input => {
      const clearButton = input.parentNode.querySelector('.clear-search-btn');
      
      // Initial state
      if (input.value) {
        clearButton.classList.remove('hidden');
      }
      
      // Update on input
      input.addEventListener('input', function() {
        if (this.value) {
          clearButton.classList.remove('hidden');
        } else {
          clearButton.classList.add('hidden');
        }
      });
    });
  });
</script> 