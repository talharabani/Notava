<div class="min-h-screen bg-gradient-to-br from-indigo-950 to-cyan-800">
  <%= render 'shared/sidebar' %>
  
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-y-auto px-4 ml-16 md:ml-64">
    <!-- Top Navigation Bar -->
    <%= render 'shared/topbar' %>

    <div class="py-6">
      <!-- Playlist Header -->
      <div class="flex flex-col md:flex-row items-start md:items-end gap-6 mb-8">
        <div class="w-48 h-48 md:w-56 md:h-56 bg-indigo-800/50 shadow-xl rounded-lg overflow-hidden">
          <img src="<%= @playlist.cover_image %>" alt="<%= @playlist.name %>" class="w-full h-full object-cover">
        </div>
        <div class="flex-1">
          <div class="text-xs text-gray-300 uppercase mb-1">Playlist</div>
          <h1 class="text-4xl md:text-5xl font-bold mb-2 text-white"><%= @playlist.name %></h1>
          <% if @playlist.description.present? %>
            <p class="text-gray-300 mb-4"><%= @playlist.description %></p>
          <% end %>
          <div class="flex items-center text-sm text-gray-400 mb-4">
            <span><%= current_user.email %></span>
            <span class="mx-2">•</span>
            <span><%= @playlist.playlist_tracks.count %> songs</span>
          </div>
          <div class="flex items-center space-x-4">
            <button class="bg-cyan-600 hover:bg-cyan-500 text-white px-8 py-3 rounded-full font-semibold transition shadow-md">
              <svg class="w-6 h-6 inline-block mr-2" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"/>
              </svg>
              Play
            </button>
            <div class="flex items-center">
              <%= link_to edit_playlist_path(@playlist), class: "text-gray-300 hover:text-white p-2" do %>
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                </svg>
              <% end %>
              <%= button_to playlist_path(@playlist), method: :delete, class: "text-gray-300 hover:text-white p-2", data: { confirm: "Are you sure you want to delete this playlist?" } do %>
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Tracks Table -->
      <div class="bg-indigo-900/40 backdrop-blur-sm rounded-lg overflow-hidden">
        <% if @tracks.any? %>
          <table class="w-full">
            <thead>
              <tr class="text-left text-gray-400 text-sm border-b border-gray-700">
                <th class="p-4 w-10">#</th>
                <th class="p-4">Title</th>
                <th class="p-4 hidden md:table-cell">Artist</th>
                <th class="p-4 hidden lg:table-cell">Album</th>
                <th class="p-4 w-20 text-right">
                  <svg class="w-5 h-5 inline" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                  </svg>
                </th>
                <th class="p-4 w-20"></th>
              </tr>
            </thead>
            <tbody>
              <% @tracks.each_with_index do |track, index| %>
                <tr class="text-white border-b border-gray-700/50 hover:bg-indigo-800/40 group">
                  <td class="p-4 text-gray-400"><%= index + 1 %></td>
                  <td class="p-4">
                    <div class="flex items-center">
                      <img src="<%= track.track_data['album']['cover_small'] || track.track_data['album']['cover_medium'] %>" alt="<%= track.track_data['title'] %>" class="w-10 h-10 mr-3 rounded">
                      <span class="truncate"><%= track.track_data['title'] %></span>
                    </div>
                  </td>
                  <td class="p-4 text-gray-300 hidden md:table-cell truncate"><%= track.track_data['artist']['name'] %></td>
                  <td class="p-4 text-gray-300 hidden lg:table-cell truncate"><%= track.track_data['album']['title'] %></td>
                  <td class="p-4 text-gray-400 text-right"><%= track.track_data['duration'] ? "#{track.track_data['duration'] / 60}:#{(track.track_data['duration'] % 60).to_s.rjust(2, '0')}" : "0:00" %></td>
                  <td class="p-4 text-right">
                    <div class="flex items-center justify-end space-x-2">
                      <%= button_to remove_track_playlist_path(@playlist, track_id: track.track_id), method: :delete, class: "text-gray-400 hover:text-white opacity-0 group-hover:opacity-100 transition-opacity", title: "Remove from playlist" do %>
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M19 13H5v-2h14v2z"/>
                        </svg>
                      <% end %>
                      <button class="text-gray-400 hover:text-white opacity-0 group-hover:opacity-100 transition-opacity" 
                              data-song='<%= track.track_data.to_json %>'
                              data-action="click->player#playSong">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="text-center py-10 text-gray-400">
            <p>No tracks in this playlist yet.</p>
            <p class="text-sm mt-2">Browse music and add songs to your playlist!</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  
  <!-- Player Bar -->
  <%= render 'shared/player' %>
</div>
